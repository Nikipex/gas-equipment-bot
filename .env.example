# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Bot internal DB, reserved for future SQLAlchemy/Alembic storage
DATABASE_URL=postgresql+asyncpg://bot:bot_password@localhost:5432/gas_equipment

# Readonly 1C PostgreSQL source
PROCUREMENT_DATABASE_URL=postgresql+psycopg2://user:password@host:5432/torg_full

# Runtime
LOG_LEVEL=INFO


# MAX Messenger
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_DOWNLOAD_DIR=data/max_downloads


# Telegram alerts for background workers
TELEGRAM_ADMIN_CHAT_ID=


# AI intent layer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_INTENT_ENABLED=false


# AI intent layer — YandexGPT / AI Studio
AI_INTENT_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/rc
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
